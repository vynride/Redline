# Redline on AWS — rendered by Terraform into /opt/redline/compose.yml.
# Only nginx publishes a port; the security group lets CloudFront alone reach it.

# Every container: no privilege escalation via setuid binaries.
x-hardening: &hardening
  security_opt:
    - no-new-privileges:true

x-logging: &cloudwatch
  driver: awslogs
  options:
    awslogs-region: ${region}
    awslogs-group: ${log_group}
    tag: "{{.Name}}"

services:
  backend:
    build: ./src/backend
    cap_drop: [ALL] # runs as an unprivileged user on a high port; needs no capabilities
    env_file: ./backend.env # secrets pulled from SSM Parameter Store
    environment:
      ENVIRONMENT: production
      DEBUG: "false"
      CORS_ORIGINS: ${public_url}
      FRONTEND_URL: ${public_url}
      OAUTH_REDIRECT_BASE: ${public_url}
    restart: unless-stopped
    logging: *cloudwatch
    <<: *hardening

  frontend:
    cap_drop: [ALL]
    build:
      context: ./src
      dockerfile: frontend/Dockerfile
      args:
        NEXT_PUBLIC_API_BASE: ${public_url}
    depends_on:
      - backend
    restart: unless-stopped
    logging: *cloudwatch
    <<: *hardening

  nginx:
    image: nginx:1.30-alpine # current stable branch
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - backend
      - frontend
    restart: unless-stopped
    logging: *cloudwatch
    <<: *hardening
