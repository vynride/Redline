# Redline — nginx inside Docker, behind CloudFront. Rendered by Terraform.
#   /api/*  -> backend:8000   (FastAPI REST)
#   /ws/*   -> backend:8000   (drill WebSocket)
#   /*      -> frontend:3000  (Next.js)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    # Only CloudFront knows this value; direct hits on the EC2 address get 403.
    if ($http_x_origin_verify != "${origin_verify}") {
        return 403;
    }

    client_max_body_size 12m;

    # CloudFront always talks to viewers over HTTPS (redirect-to-https).
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_read_timeout 120s;
    }

    location /ws/ {
        proxy_pass http://backend:8000;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://frontend:3000;
    }
}
